# Obtain your own credentials; never commit real values.
AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_DEFAULT_CITY=

GEETEST_ENABLED=true
GEETEST_CAPTCHA_ID=
GEETEST_API_KEY=

# Optional sign-in failure notifications. Email registration stays disabled.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional AI report drafts: provide your own HTTPS Chat Completions service.
# All three values are required. Never put these in frontend/VITE variables.
REPORT_AI_BASE_URL=
REPORT_AI_MODEL=
REPORT_AI_API_KEY=

# Set these through the process environment, not the application .env loader.
# Configure only the actual HTTPS reverse proxy addresses you trust.
# XIXUN_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# XIXUN_SECURE_COOKIES=true
